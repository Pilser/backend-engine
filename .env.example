# serverless-worker configuration (Cloudflare Workers friendly)
#
# WORKERS RULES — read before adding anything here:
# - NO ports/hosts: there is no TCP listener on Workers. The public address is
#   WORKER_URL (set after first deploy, e.g.
#   https://serverless-worker.<account>.workers.dev). Never add SRV_HOST/SRV_PORT.
# - NO database URLs: storage is via bindings declared in wrangler.toml
#   (D1 `DB`, R2 `STORE`, Durable Object `TENANT_DO`, KV). Never add
#   SRV_DB / SRV_HELIX_URL / SRV_DATA_DIR / connection strings.
# - Secrets (SECRET_KEY, WORKER_KEY) are NOT set here in production. Local dev:
#   copy this file to `.dev.vars` (git-ignored). Production: `wrangler secret put`
#   or `scripts/sync-worker.sh` (reads them from your shell env, never a file).
# - Plain (non-secret) vars go in wrangler.toml `[vars]`, not here.
#
# For CI: set GitHub Secrets CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID.
# The deploy workflow + scripts/sync-worker.sh handle the rest.

# Public URL of this Worker (no port — Workers route by URL, not host:port).
# Fill in after first `wrangler deploy`; used by webhook callbacks that need
# to reach this worker itself.
WORKER_URL=https://serverless-worker.<account>.workers.dev

# AI assistant backend base URL (fallback when the AI_BASE_URL tenant secret
# is absent). Plain value (a URL, not a secret); empty = unconfigured.
# AI_TARGET=https://ai-backend.example.com

# Outbound HTTP call timeout in milliseconds (recipe $call / jobs / webhooks).
HTTP_TIMEOUT_MS=15000

# Bearer key for admin routes. DEV ONLY here — production via wrangler secret.
WORKER_KEY=dev-change-me

# Master key for at-rest secret encryption (AES-256-GCM), 32 bytes base64.
# DEV ONLY here — production via wrangler secret. Never commit the real one.
SECRET_KEY=
